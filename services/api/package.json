{
  "name": "@sajawat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.development src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"@sajawat/api: tests configured in milestone 0.9\" && exit 0"
  },
  "dependencies": {
    "@sajawat/shared": "workspace:*",
    "@sajawat/types": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "mongoose": "^9.6.3",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "^3"
  },
  "devDependencies": {
    "@sajawat/config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5",
    "@types/node": "^22",
    "eslint": "^9.18.0",
    "pino-pretty": "^13",
    "tsx": "^4",
    "typescript": "^5.7.2"
  }
}
