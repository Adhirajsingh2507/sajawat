{
  "name": "@sajawat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.development --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env.production --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@sajawat/shared": "workspace:*",
    "@sajawat/types": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jose": "^6.2.3",
    "mongoose": "^9.6.3",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "^3"
  },
  "devDependencies": {
    "@sajawat/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5",
    "@types/node": "^22",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.18.0",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13",
    "supertest": "^7.2.2",
    "tsx": "^4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
