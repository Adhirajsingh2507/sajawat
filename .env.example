# ============================================================
# SAJAWAT — API ENVIRONMENT VARIABLE TEMPLATE  (services/api)
# ============================================================
# Loading model (Milestone 0.6 — Node-native `--env-file`, no dotenv dep):
#   precedence low -> high:
#     .env.<NODE_ENV>   (canonical per-environment config; e.g. .env.development)
#     .env              (OPTIONAL personal local override; wins over the above)
#     process.env       (platform-injected; Cloud Run + Secret Manager — wins over all)
#   In cloud there are NO .env files: Cloud Run injects vars (secrets from Google
#   Secret Manager), so `--env-file-if-exists` is a no-op there.
#
# Setup:  copy this file to `.env.development` and fill in local values.
# NEVER commit real values — only `*.example` templates are allowed (enforced by
# a pre-commit guard). See docs/sajawat-environment-guide.md.
#
# [secret] = store in Google Secret Manager in cloud; keep only in gitignored
#            local files for development.
# ============================================================

# ---- Runtime ----
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- API (services/api) ----
API_PORT=4000
API_BASE_URL=http://localhost:4000

# ---- Security ----
# Comma-separated CORS allow-list (web :3000, admin :3001 by default).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Global per-IP rate limit (window in ms, max requests per window).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---- Database (MongoDB Atlas) ----
# REQUIRED. [secret] mongodb:// or mongodb+srv:// connection string (carries credentials).
MONGODB_URI=
# Optional explicit DB name (otherwise taken from the URI path).
MONGODB_DB_NAME=
# Connection pool sizing — keep modest under Cloud Run autoscaling
# (instances x maxPoolSize must stay below the Atlas connection cap).
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
# Fail fast if Atlas is unreachable; bound socket idle time.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
# Bounded exponential backoff for the initial connect (driver auto-reconnects after).
MONGODB_CONNECT_RETRY_ATTEMPTS=5
MONGODB_CONNECT_RETRY_BASE_MS=1000

# ---- Auth / JWT ----  [secret] (0.7)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Google OAuth ----  [secret]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Payment (Razorpay — Phase 1) ----  [secret]
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- SMS (MSG91) ----  [secret]
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=

# ---- WhatsApp (Official WhatsApp Business API — Meta) ----  [secret]
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# ---- Email (SMTP) ----  [secret] (SMTP_PASSWORD)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Google Cloud Storage ----  [secret] (GCS_PRIVATE_KEY)
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=

# ---- Redis (Phase 2 — planned, not used yet) ----
# REDIS_URL=

# ---- Frontend (Next.js apps) ----
# NEXT_PUBLIC_* variables are owned by the per-app templates and loaded by the
# Next.js runtime (not by the API). See:
#   apps/web/.env.example  ·  apps/admin/.env.example
# Only NON-SECRET values may carry the NEXT_PUBLIC_ prefix — it ships to the browser.
