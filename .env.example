# ============================================================
# SAJAWAT — ENVIRONMENT VARIABLE TEMPLATE
# Copy to .env.development / .env.staging / .env.production
# NEVER commit real values. Cloud environments use Google Secret Manager.
# ============================================================

# ---- Runtime ----
NODE_ENV=development

# ---- API (services/api) ----
API_PORT=4000
API_BASE_URL=http://localhost:4000

# ---- Database (MongoDB Atlas) ----
MONGODB_URI=

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Payment (Razorpay — Phase 1) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- SMS (MSG91) ----
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=

# ---- WhatsApp (Official WhatsApp Business API — Meta) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Google Cloud Storage ----
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=

# ---- Analytics ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Web apps ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# ---- Redis (Phase 2 — planned, not used yet) ----
# REDIS_URL=
