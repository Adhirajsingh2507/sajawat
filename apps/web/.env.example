# ============================================================
# SAJAWAT — CUSTOMER WEB ENV TEMPLATE  (apps/web, Next.js :3000)
# ============================================================
# Loaded by the Next.js runtime (NOT Node `--env-file`). Next reads, in order:
#   .env  ->  .env.<NODE_ENV>  ->  .env.local  (see sajawat-environment-guide.md)
# Copy to `.env.local` for local development.
#
# Only NON-SECRET values may use the NEXT_PUBLIC_ prefix — these are inlined into
# the client bundle and shipped to the browser. Never put a secret here.
# Server-only secrets (if any) go in unprefixed vars consumed server-side.
# ============================================================

# Public base URL of the API (versioned).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# ---- Analytics (public measurement IDs only) ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
