{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@sajawat/config nextjs (apps/web, apps/admin)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  }
}
