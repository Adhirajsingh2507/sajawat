{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@sajawat/config react-library (source, noEmit — e.g. @sajawat/ui)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  }
}
